# Public connection values only. Obtain these from the Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Exact HTTPS origin in production; no trailing slash.
APP_ORIGIN=http://localhost:3000
# Server-only. Also configure private.allowed_email_domains in the database;
# both checks must allow the exact domain. The migration defaults to usc.edu.
USC_EMAIL_DOMAINS=usc.edu
# No administrative credential is required by the application.
# Configure SMTP and the OTP email template inside Supabase, never here.
